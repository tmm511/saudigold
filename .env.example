# Required — Discord Developer Portal > Your App > Bot > Reset Token
DISCORD_TOKEN=

# Optional — a server ID makes /gold appear instantly in that server.
# Leave empty to register globally (can take up to an hour to show up).
GUILD_ID=

# Optional — channel ID for automatic price updates. Leave empty to disable.
AUTO_CHANNEL_ID=
# How often the poll loop runs. The Discord message is only edited when a price
# actually changed, so a short interval is cheap. Minimum 5. Each site also has
# its own minimum gap between real requests (see SOURCES in src/prices.js):
# ounce.com.sa every 5s, saudigoldprice.com every 15s.
REFRESH_SECONDS=5
# edit = keep one live message updated in place | post = send a new message each cycle
AUTO_MODE=edit

# When a price moves, send a mention into AUTO_CHANNEL_ID and delete it again a
# few seconds later, so members get the notification without a pile of pings.
# The bot needs the "Mention Everyone" permission in that channel, otherwise
# Discord shows "@here" as plain text and notifies nobody.
PING_ON_CHANGE=true
PING_TEXT=@here تغيّرت أسعار الذهب 🔔
PING_DELETE_SECONDS=5

# Embed footer, shown before the source timestamp. Keep it left-to-right:
# Discord reorders a line that mixes Arabic with Latin text and numbers.
FOOTER_TEXT=@._q // tm

# Presence under the bot's name. Only visible while `npm start` is running —
# presence requires a gateway connection, so the scheduled GitHub Actions
# poster cannot set it.
STATUS_TEXT=/baba tm
# streaming | playing | listening | watching | competing
STATUS_TYPE=streaming
# Required for the purple "Streaming" label. Must be twitch.tv or youtube.com,
# and the channel does not need to be live.
STATUS_URL=https://twitch.tv/tmm511
# online | idle | dnd
STATUS_ONLINE=online

# Optional — !gold / !ذهب text commands.
# Requires enabling the "Message Content Intent" in the Developer Portal.
ENABLE_PREFIX_COMMANDS=false
PREFIX=!
