# Required — Discord Developer Portal > Your App > Bot > Reset Token
DISCORD_TOKEN=

# Optional — a server ID makes /gold appear instantly in that server.
# Leave empty to register globally (can take up to an hour to show up).
GUILD_ID=

# Optional — channel ID for automatic price updates. Leave empty to disable.
AUTO_CHANNEL_ID=
REFRESH_MINUTES=30
# edit = keep one live message updated in place | post = send a new message each cycle
AUTO_MODE=edit

# Optional — !gold / !ذهب text commands.
# Requires enabling the "Message Content Intent" in the Developer Portal.
ENABLE_PREFIX_COMMANDS=false
PREFIX=!
